# AI Provider Configuration
# Set your Gemini API key (optional for basic running; required for advanced AI summaries)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# Server Configuration
PORT=3000
NODE_ENV=development

# Hostinger / Custom SMTP Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Email Dispatch
EMAIL_FROM="AI Intelligence Radar <radar@yourdomain.com>"
EMAIL_TO=recipient@example.com

# Timezone Configuration (for 6:45 AM digest compilation and 7:00 AM dispatch)
TIMEZONE=Asia/Kolkata

# Ingestion Polling Interval (in minutes, default: 15)
INGESTION_INTERVAL_MINUTES=15
